# Which model does the try-on:
#   mock   paints coloured blocks; for development only
#   fashn  FASHN's hosted API (https://fashn.ai), pay per image, no GPU needed
#   local  FASHN VTON v1.5 on your own GPU (open source, Apache-2.0)
TRYON_PROVIDER=fashn
FASHN_API_KEY=
# performance | balanced | quality
FASHN_MODE=balanced
# only for TRYON_PROVIDER=local
TRYON_WEIGHTS_DIR=./weights

# Two random strings. Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# TRYON_APP_KEY is built into the app; TRYON_SECRET never leaves the server.
TRYON_APP_KEY=
TRYON_SECRET=

# Spending limits, in generations (one generation = one try-on image)
TRYON_PER_DEVICE_HOURLY=40
TRYON_PER_DEVICE_DAILY=120
TRYON_GLOBAL_DAILY=2000
